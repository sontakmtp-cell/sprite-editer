{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-sheet-builder.local/schemas/atlas-v1.schema.json",
  "title": "Sprite Sheet Builder Atlas Metadata V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "image", "atlas", "frames", "animations"],
  "properties": {
    "format": { "const": "sprite-sheet-builder-atlas" },
    "schemaVersion": { "const": 1 },
    "image": { "type": ["string", "null"] },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "cols", "rows", "cellWidth", "cellHeight", "origin", "indexBase"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cellWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "cellHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "origin": { "const": "top-left" },
        "indexBase": { "const": 0 },
        "guidesNormalized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "row", "col", "x", "y", "w", "h", "empty"],
        "properties": {
          "id": { "type": "string" },
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "w": { "type": "integer", "minimum": 1 },
          "h": { "type": "integer", "minimum": 1 },
          "empty": { "type": "boolean" },
          "anchorCellPx": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "contentBoundsCellPx": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 0 },
              "h": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fps", "loopMode", "frames"],
        "properties": {
          "name": { "type": "string" },
          "fps": { "type": "number", "minimum": 1, "maximum": 60 },
          "loopMode": { "enum": ["loop", "once", "pingpong"] },
          "guidesNormalized": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frameId", "durationMs"],
              "properties": {
                "frameId": { "type": "string" },
                "durationMs": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
