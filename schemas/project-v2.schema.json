{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-sheet-builder.local/schemas/project-v2.schema.json",
  "title": "Sprite Sheet Builder Project Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "name",
    "grid",
    "presetId",
    "sources",
    "assets",
    "cells",
    "animations",
    "settings",
    "customPresets"
  ],
  "properties": {
    "format": {
      "const": "sprite-sheet-builder-project"
    },
    "schemaVersion": {
      "const": 2
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows", "cellWidth", "cellHeight"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cellWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "cellHeight": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "presetId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "expectedCells": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "pattern": "^[0-9]+:[0-9]+$"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "mime", "width", "height", "byteLength"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "path": { "type": "string", "pattern": "^sources/[A-Za-z0-9_-]+\\.(png|webp|jpg|jpeg)$" },
          "mime": { "enum": ["image/png", "image/webp", "image/jpeg"] },
          "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "byteLength": { "type": "integer", "minimum": 1, "maximum": 20971520 },
          "importedAt": { "type": "integer", "minimum": 0 },
          "exifOrientation": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceId", "name", "region"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "isRegion": { "type": "boolean" },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "fitMode", "alphaThreshold", "zoom", "offsetX", "offsetY", "anchor"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "fitMode": { "enum": ["contain", "alpha"] },
          "alphaThreshold": { "type": "integer", "minimum": 0, "maximum": 254 },
          "zoom": { "type": "number", "minimum": 0.25, "maximum": 10.0 },
          "offsetX": { "type": "number" },
          "offsetY": { "type": "number" },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["fit-center", "alpha-bottom-center", "custom"] },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "fps", "loopMode", "frames"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "fps": { "type": "number", "minimum": 1, "maximum": 60 },
          "loopMode": { "enum": ["loop", "once", "pingpong"] },
          "guides": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "sizeVarianceThreshold": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 5
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row", "col", "durationMs"],
              "properties": {
                "row": { "type": "integer", "minimum": 0, "maximum": 63 },
                "col": { "type": "integer", "minimum": 0, "maximum": 63 },
                "durationMs": {
                  "type": ["number", "null"],
                  "minimum": 10,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoothing", "guides", "defaultAlphaThreshold", "webpQuality"],
      "properties": {
        "smoothing": { "type": "boolean" },
        "guides": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "defaultAlphaThreshold": { "type": "integer", "minimum": 0, "maximum": 254 },
        "webpQuality": { "type": "number", "minimum": 0.01, "maximum": 1.0 }
      }
    },
    "customPresets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "preset-v1.schema.json"
      }
    }
  }
}
